{
  "name": "ticketstore-digital-event-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Event Poster: a one-page event microsite template for Ticketstore.ro organizers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "export:preview": "PREVIEW_ENTRY=1 node scripts/export-relative.mjs",
    "demo-media": "python3 scripts/generate-demo-media.py",
    "build:static": "STATIC_EXPORT=1 next build",
    "build:concordia": "SITE=concordia STATIC_EXPORT=1 next build",
    "dev:concordia": "SITE=concordia next dev"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9"
  }
}
